# Server-only secrets — copy to .env or .env.local and fill in real values.
# NEVER commit real credentials; both files are gitignored.

# MongoDB connection string (least-privilege credentials; TLS in production)
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sadikecom

# iron-session cookie sealing password — must be at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_PASSWORD=change-me-to-a-long-random-string-32+

# Admin bootstrap (consumed by `npm run admin:create`; optional — the script
# prompts interactively when these are unset). Inject via a secret manager at
# bootstrap time in production; never commit real values.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_DISPLAY_NAME=

# Paystack (server-side only — never expose via NEXT_PUBLIC_*).
# Checkout is disabled until this is set. Get keys from the Paystack
# dashboard → Settings → API Keys & Webhooks.
# PAYSTACK_SECRET_KEY=sk_test_...
# Charge currency — must match the storefront's displayed prices and a
# currency enabled on your Paystack business (default USD).
# PAYSTACK_CURRENCY=USD
# Public origin used to build the payment callback URL.
# APP_BASE_URL=http://localhost:3000
# Flat shipping fee in major units added at checkout (default 0).
# SHIPPING_FEE=0
# Webhook endpoint to register in the Paystack dashboard:
#   POST {APP_BASE_URL}/api/payments/paystack

# Cloudinary — admin product-image uploads (server-side only).
# Dashboard → Settings → Access Keys. Uploads are disabled until all
# three values are set.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Target folder for product images (default "products").
# CLOUDINARY_UPLOAD_FOLDER=products
